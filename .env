# App
APP_NAME=events-worker
LOG_LEVEL=INFO

# Kafka Configs
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_NAME=api.messages
KAFKA_CLIENT_ID=python-api
KAFKA_GROUP_ID=python-api-consumer-group

# RabbitMQ Configs
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=rabbitmq
RABBITMQ_PASSWORD=rabbitmq
USERS_QUEUE_NAME=users.creation

# Postgres Configs
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres_db
